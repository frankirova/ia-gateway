# Environment for /usr/local/bin/vps-report-run, read by the forced command.
# Install as /etc/host-report/vps.env, root:<report account group>, mode 0640.
# The group matters: the forced command reads this file as the report account,
# so root:root would lock it out.
#
# This file describes the VPS as a *remote* host. The report runs here, on the
# collecting server, and reaches the VPS over SSH, so the VPS itself gets no
# listener, no schedule and no credential of its own: the secrets below stay on
# this side. Secrets are files, never values: only paths appear here.

# The label this report carries: the deduplication key and the message header.
HOST_REPORT_HOST=vps

# Which containers this report covers is not decided here: the VPS owns that
# list in its own root-owned /etc/vps-readonly.json, so the subject never sends
# what nobody asked for. A container named there that is not running becomes a
# finding, not an absence of news. See deploy/vps-report/README.md.

# The evidence comes from the VPS over SSH, not from this machine's Docker
# socket. Leave it as `ssh`; `local` would report the collecting server instead.
HOST_REPORT_TARGET=ssh

# REQUIRED, and the one line a fresh install cannot fill in: the SSH destination
# of the VPS exactly as the `ssh` client takes it — `user@host`, or an alias from
# the report account's ~/.ssh/config, which is where the dedicated private key
# and its options belong. While it is empty the run fails loudly instead of
# reporting this server twice.
HOST_REPORT_SSH_TARGET=

# Seconds one bundle read may take before the VPS counts as unreachable.
HOST_REPORT_SSH_TIMEOUT=60

# The endpoints the report probes for reachability, as a JSON list. Empty means
# "probe nothing" and no HTTP section appears in the report. Uncomment and edit
# once the two services are known: `name` is what the reader sees, so keep it
# short, and `expect_status` is the only status counted as healthy.
# HOST_REPORT_ENDPOINTS=[{"name":"app","url":"https://app.example.com/healthz","expect_status":200},{"name":"api","url":"https://api.example.com/healthz","expect_status":200}]
HOST_REPORT_ENDPOINTS=

# Same reporter, same installations: these are the gateway key and the hub token
# that host-report-run already uses, so only one secret of each exists on the
# server. Do not copy the secret values into this file.
HOST_REPORT_GATEWAY_URL=https://gateway.internal
HOST_REPORT_GATEWAY_KEY_FILE=/etc/host-report/gateway.key
HOST_REPORT_GATEWAY_CA_BUNDLE=/opt/stacks/gateway/ca/caddy-root.crt

HOST_REPORT_HUB_URL=http://192.0.2.10:8000
HOST_REPORT_HUB_TOKEN_FILE=/etc/host-report/hub.token
HOST_REPORT_HUB_CHAT=owner

# Uncomment to pin the deduplication key instead of deriving it per slot. The
# derived key is vps-report:<HOST_REPORT_HOST>:<YYYY-MM-DD>T<00|06|12|18>.
# HOST_REPORT_NOTIFY_KEY=

# Noise filtering and the per-container caps keep the defaults from
# tasks/host_report/settings.py. Uncomment only to override them.
# HOST_REPORT_IGNORE=
# HOST_REPORT_CONTAINER_LIMITS=
