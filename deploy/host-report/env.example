# Environment for /usr/local/bin/host-report-run, read by the forced command.
# Install as /etc/host-report/env, root:<report account group>, mode 0640.
# The group matters: the forced command reads this file as the report account,
# so root:root would lock it out.
# Secrets are files, never values: only paths appear here.

# Read-only Docker transport. Until the socket proxy exists, use
# unix:///var/run/docker.sock and give the service account the docker group.
HOST_REPORT_DOCKER_URL=unix:///var/run/docker.sock

HOST_REPORT_GATEWAY_URL=https://gateway.internal
HOST_REPORT_GATEWAY_KEY_FILE=/etc/host-report/gateway.key
HOST_REPORT_GATEWAY_CA_BUNDLE=/opt/stacks/gateway/ca/caddy-root.crt

HOST_REPORT_HUB_URL=http://192.0.2.10:8000
HOST_REPORT_HUB_TOKEN_FILE=/etc/host-report/hub.token
HOST_REPORT_HUB_CHAT=owner

# Uncomment to pin the deduplication key instead of deriving it per slot.
# HOST_REPORT_NOTIFY_KEY=
